{
  "schemaVersion": 1,
  "name": "crush",
  "displayName": "crush",
  "role": "main",
  "requires": { "codingRuntime": ">=0.1.2 <1.0.0" },
  "env": { "CRUSH_GLOBAL_CONFIG": "${STATE_DIR}/crush", "CRUSH_DISABLE_METRICS": "1" },
  "preflight": [{ "path": "${STATE_DIR}/crush", "mode": "700" }],
  "config": { "emitter": { "type": "module", "path": "/opt/adapter/emit.mjs" } },
  "serve": { "surface": "terminal", "port": 8080, "originGuard": true },
  "terminal": {
    "tmuxSession": "crush",
    "launch": ["launch-crush"],
    "cwd": "${WORKDIR}",
    "wsPath": "/ws",
    "keepaliveSeconds": 25
  }
}
